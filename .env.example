# Server-side only. None of these ever reach the browser.
# After adding these in Netlify: Deploys > Trigger deploy >
# "Clear cache and deploy site". A finished build will not pick them up.

# Used by netlify/functions/claude.js — the coach and the workbench read.
ANTHROPIC_API_KEY=

# Used by netlify/functions/notes.js — workbench notes only, no student data.
# The token needs scopes data.records:read AND data.records:write, AND the
# base added explicitly under Access. Right scopes with no base = 403.
AIRTABLE_API_KEY=

# Base "Ministry Map — Workbench", deliberately separate from Ministry Map.
AIRTABLE_BASE_ID=applBnNxBseAJT5kO
AIRTABLE_NOTES_TABLE=Workbench
